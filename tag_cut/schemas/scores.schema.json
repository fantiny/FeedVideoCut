{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapabilityScores",
  "description": "Aggregate capability scores for a shot, all floats in [0, 1].",
  "type": "object",
  "required": ["shot_id"],
  "minProperties": 2,
  "properties": {
    "shot_id": { "type": "string", "description": "Parent shot UUID" },
    "hook_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Opening hook strength" },
    "evidence_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Evidence/proof quality" },
    "emotion_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Emotional resonance" },
    "product_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Product presentation quality" },
    "conversion_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Conversion / CTA effectiveness" },
    "ending_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Ending impact" },
    "transition_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Transition smoothness" },
    "trust_score": { "type": "number", "minimum": 0, "maximum": 1, "description": "Trust / authenticity signal" }
  },
  "additionalProperties": false
}
