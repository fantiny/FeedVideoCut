# Auto-detect text; normalize line endings
* text=auto eol=lf

*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf

*.pt binary
*.onnx binary
*.mp4 binary
*.png binary
*.jpg binary
*.zip binary
